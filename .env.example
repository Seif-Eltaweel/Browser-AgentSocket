# AgentSocket Environment Configuration Template
# Copy this file to .env and populate with your local values.
# DO NOT commit .env to version control.

# Gateway Settings
AGENTSOCKET_PORT=8000
AGENTSOCKET_TOKEN=
SOCKET_IDLE_TIMEOUT=1200
SOCKET_LOG_LEVEL=INFO

# Storage & State Overrides (Optional)
AGENTSOCKET_STATE_DIR=
AGENTSOCKET_DB_PATH=
AGENTSOCKET_LOGS_DIR=

# AI Agent Model Credentials (If running external agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
